configuration {
    show-icons: true;
    drun-display-format: "{name}";
}

* {
    base:        #1e1e2e;
    surface0:    #313244;
    surface1:    #45475a;
    text:        #cdd6f4;
    subtext:     #a6adc8;
    mauve:       #cba6f7;

    background-color: transparent;
    text-color:       @text;
    font:             "JetBrainsMono Nerd Font 12";
}

window {
    width:            500px;
    border:           2px;
    border-color:     @mauve;
    border-radius:    0px;
    padding:          15px;
    background-color: @base;
}

mainbox {
    spacing:          10px;
}

inputbar {
    spacing:          10px;
    padding:          8px 12px;
    background-color: @surface0;
    border-radius:    0px;
    children:         [ prompt, entry ];
}

prompt {
    text-color:       @mauve;
}

entry {
    text-color:       @text;
    placeholder:      "Suchen...";
    placeholder-color:@subtext;
}

listview {
    spacing:          4px;
    fixed-height:     false;
    lines:            8;
    scrollbar:        false;
}

element {
    padding:          8px 12px;
    border-radius:    0px;
    spacing:          10px;
    background-color: transparent;
    text-color:       @text; /* Erzwingt die helle Textfarbe für normale Elemente */
}

element normal.normal {
    background-color: transparent;
    text-color:       @text; /* Verhindert das braune Fallback bei normalen Einträgen */
}

element selected.normal {
    background-color: @surface1;
    text-color:       @mauve;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @text; /* Verhindert das braune Fallback bei alternierenden Einträgen */
}

element-text {
    background-color: transparent;
    text-color:       inherit;
}

element-icon {
    background-color: transparent;
    size:             1.2em;
}